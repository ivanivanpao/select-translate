{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "select-translate",
  "version": "0.1.0",
  "identifier": "com.ivani.select-translate",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Select-Translate 設定",
        "url": "index.html",
        "width": 440,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Select-Translate",
        "url": "popup.html",
        "width": 380,
        "height": 120,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
